NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Opcional — sem isso (ou sem ANTHROPIC_API_KEY), Estrategista e Auditor usam
# o motor determinístico (sem custo, sem chamada de IA).
# "anthropic" força uso da API Claude e nunca cai no determinístico em silêncio
# (se a chamada falhar, o erro é propagado). "deterministic" força o motor
# determinístico mesmo com chave configurada. Deixe em branco para
# auto-detectar pela presença de ANTHROPIC_API_KEY.
AI_PROVIDER=

ANTHROPIC_API_KEY=
# Modelo usado pelo Agente Estrategista (geração de campanha).
ANTHROPIC_STRATEGY_MODEL=claude-sonnet-5
# Modelo usado pelo Agente Auditor (nunca reaproveita o do Estrategista).
ANTHROPIC_AUDITOR_MODEL=claude-sonnet-5
